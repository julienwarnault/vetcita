@mjml({
  validationLevel: 'soft',
})
  <mjml>
    <mj-head>
      <mj-title>
        Contraseña actualizada
      </mj-title>
      <mj-preview>
        Tu contraseña ha sido actualizada.
      </mj-preview>
      <mj-attributes>
        <mj-all font-family="Arial, Helvetica, sans-serif" />
        <mj-text color="#222222" font-size="16px" line-height="24px" padding="0" />
        <mj-section padding="0" />
        <mj-column padding="0" />
      </mj-attributes>
    </mj-head>

    <mj-body background-color="#f9f9f9" width="560px">
      <mj-section padding="32px 0 16px">
        <mj-column>
          <mj-image
            src="{{ embedImage(app.makePath('public/images/logo.png')) }}"
            alt="Vetcita"
            width="160px"
            height="42px"
            align="left"
            padding="0"
          />
        </mj-column>
      </mj-section>

      <mj-wrapper background-color="#ffffff" border="1px solid #e6e6e6" border-radius="18px" padding="32px">
        <mj-section padding="0">
          <mj-column>
            <mj-text padding="0 0 12px" color="#222222" font-size="28px" line-height="34px" font-weight="700">
              Tu contraseña ha sido actualizada
            </mj-text>

            <mj-text padding="0" color="#81817e" font-size="16px" line-height="24px">
              Hola{{ user.firstName ? ' ' + user.firstName : '' }}, confirmamos que la contraseña de tu cuenta se ha actualizado correctamente.
            </mj-text>

            <mj-text padding="24px 0 0" color="#81817e" font-size="14px" line-height="20px">
              Si no realizaste este cambio, contacta con el soporte lo antes posible.
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-wrapper>

      <mj-section padding="18px 0 32px">
        <mj-column>
          <mj-text color="#81817e" font-size="12px" line-height="18px">
            Este email ha sido enviado por Vetcita para confirmar un cambio de contraseña en tu cuenta.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
@end
