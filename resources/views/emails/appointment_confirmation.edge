<h1>
  Confirmación de su cita
</h1>

<p>
  Hola {{ client.fullName }},
</p>

<p>
  Su cita ha sido confirmada.
</p>

<ul>
  <li>
    Servicio: {{ service }}
  </li>
  <li>
    Fecha y hora: {{ startDate }}
  </li>
  <li>
    Referencia: {{ bookingRef }}
  </li>
</ul>

<p>
  <a href="{{ confirmUrl }}">Ver mi cita</a>
</p>

<p>
  Gracias.
</p>
