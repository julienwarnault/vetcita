@mjml({
  validationLevel: 'soft',
})
  <mjml>
    <mj-head>
      <mj-title>
        Confirmación de su cita
      </mj-title>
      <mj-preview>
        {{ tenantName }} ha confirmado tu cita.
      </mj-preview>
      <mj-attributes>
        <mj-all font-family="Arial, Helvetica, sans-serif" />
        <mj-text color="#222222" font-size="16px" line-height="24px" padding="0" />
        <mj-section padding="0" />
        <mj-column padding="0" />
        <mj-button
          background-color="#0d0d0d"
          color="#ffffff"
          border-radius="999px"
          font-size="16px"
          font-weight="700"
          line-height="20px"
          inner-padding="14px 20px"
          padding="0"
        />
      </mj-attributes>
    </mj-head>

    <mj-body background-color="#f9f9f9" width="560px">
      <mj-section padding="32px 0 16px">
        <mj-column>
          <mj-image
            src="{{ embedImage(app.makePath('public/images/logo.png')) }}"
            alt="Vetcita"
            width="160px"
            height="42px"
            align="left"
            padding="0"
          />
        </mj-column>
      </mj-section>

      <mj-wrapper background-color="#ffffff" border="1px solid #e6e6e6" border-radius="18px" padding="32px">
        <mj-section padding="0">
          <mj-column>
            <mj-text padding="0 0 18px">
              <span
                style="display:inline-block;padding:6px 10px;border-radius:999px;background:#dfe1ff;color:#222222;font-size:13px;line-height:16px;font-weight:600;"
              >
                Cita confirmada
              </span>
            </mj-text>

            <mj-text padding="0 0 12px" color="#222222" font-size="28px" line-height="34px" font-weight="700">
              Tu cita ha sido confirmada
            </mj-text>

            <mj-text padding="0 0 24px" color="#81817e" font-size="16px" line-height="24px">
              Hola {{ client.fullName }}, {{ tenantName }} ha confirmado tu cita.
            </mj-text>

            <mj-table padding="0 0 28px">
              <tr>
                <td style="padding:14px 0;border-top:1px solid #e6e6e6;">
                  <div style="color:#81817e;font-size:13px;line-height:18px;">
                    Mascota
                  </div>
                  <div style="color:#222222;font-size:16px;line-height:22px;font-weight:600;">
                    {{ petName }}
                  </div>
                </td>
              </tr>
              <tr>
                <td style="padding:14px 0;border-top:1px solid #e6e6e6;">
                  <div style="color:#81817e;font-size:13px;line-height:18px;">
                    Servicio
                  </div>
                  <div style="color:#222222;font-size:16px;line-height:22px;font-weight:600;">
                    {{ service }}
                  </div>
                </td>
              </tr>
              <tr>
                <td style="padding:14px 0;border-top:1px solid #e6e6e6;">
                  <div style="color:#81817e;font-size:13px;line-height:18px;">
                    Fecha y hora
                  </div>
                  <div style="color:#222222;font-size:16px;line-height:22px;font-weight:600;">
                    {{ startDate }}
                  </div>
                </td>
              </tr>
              <tr>
                <td style="padding:14px 0;border-top:1px solid #e6e6e6;border-bottom:1px solid #e6e6e6;">
                  <div style="color:#81817e;font-size:13px;line-height:18px;">
                    Referencia
                  </div>
                  <div style="color:#222222;font-size:16px;line-height:22px;font-weight:600;">
                    {{ bookingRef }}
                  </div>
                </td>
              </tr>
            </mj-table>

            <mj-button href="{{ confirmUrl }}" align="left">
              Ver mi cita
            </mj-button>
          </mj-column>
        </mj-section>
      </mj-wrapper>

      <mj-section padding="18px 0 32px">
        <mj-column>
          <mj-text color="#81817e" font-size="12px" line-height="18px">
            Este email ha sido enviado por Vetcita a petición y por cuenta de {{ tenantName }}, porque {{ tenantName }} utiliza los servicios de Vetcita para la gestión de sus citas.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
@end
