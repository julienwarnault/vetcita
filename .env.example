# Node
TZ=UTC
PORT=3336
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# Mail
MAIL_MAILER=brevo
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
BREVO_API_KEY=your-brevo-api-key

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue
QUEUE_DRIVER=redis